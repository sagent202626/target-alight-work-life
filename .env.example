# Ops Telegram (Bundle 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin portal + pending gates
ADMIN_PORTAL_URL=
# Official primary: DATABASE_URL (shard 0, no CC_ID).
# Shared: DB_2…DB_10 (CC_ID). Backup: DATABASE_BACKUP_FALLBACK (CC_ID).
# DB_1 is unused / silent alias only — do not set.
DATABASE_URL=
# DB_1=  # silent alias only — do not set


# SEO admin Telegram (Bundle 2) — required for IndexNow / crawler / SEO report alerts
# Set on Vercel for BOTH Runtime and Build (postbuild notify-indexnow needs Build env)
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# SEO reports
SEO_REPORT_TIMEZONE=Europe/London
# CRON_SECRET=

# IndexNow — fires on VERCEL_ENV=production postbuild; set to force elsewhere
# INDEXNOW_ON_BUILD=1
# INDEXNOW_KEY=

# Local testing (dev only)
# ALLOW_LOCAL_TESTING=1

# Optional final redirect override
# NEXT_PUBLIC_REDIRECT_URL=

# Dual Neon + shared backup (DB1 → DB2 → backup)
# DB_2=
# DATABASE_BACKUP_FALLBACK=
# CC_ID=   # must match Control Center deploy exactly
